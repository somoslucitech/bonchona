{
  "name": "bonchona-chat",
  // account_id: Tu token de Cloudflare cubre dos cuentas. Sin fijarla aqui, wrangler tiene que
  // adivinar: en una terminal interactiva pregunta, y en CI o en un script falla con un
  // 7403 confuso ("account is not valid or is not authorized"). No es un secreto, es un
  // identificador: sin credenciales no sirve de nada.
  "account_id": "6f600473116b56387e386a5a4477f81d",
  "main": "index.js",
  "compatibility_date": "2025-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bonchona-db",
      "database_id": "fb82b1b8-a34f-4b11-98f9-c31f46dd8ff1"
    }
  ],
  "vars": {
    // ALLOWED_ORIGINS: Origenes que pueden abrir el WebSocket, separados por coma. El worker rechaza cualquier otro
    // para que otra web no monte su propio chat sobre nuestra sala.
    "ALLOWED_ORIGINS": "https://bonchona.somoslucitech.workers.dev,https://bonchonaradio.com,https://www.bonchonaradio.com,http://localhost:3000,http://127.0.0.1:3000"
  },
  "observability": {
    "enabled": true
  }
}
