{
  "name": "bonchona-sampler",
  "main": "index.js",
  // account_id: cuenta bonchona1071. El token cubre varias cuentas; sin fijarla, wrangler
  // pregunta interactivamente o falla en un script no interactivo.
  "account_id": "fd561fd839efecdfc830bdd216c925b5",
  "compatibility_date": "2025-02-01",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bonchona-db",
      "database_id": "f303dab4-c82d-4491-a774-961babbab27e"
    }
  ],
  // Ya no hay STREAM_STATUS_URL aqui: el worker lee la URL real de la tabla
  // `settings` (clave stream_metadata_url), la misma que edita el admin. Tener
  // una copia fija aqui fue justo lo que quedo desactualizado cuando cambio el
  // hostname del Icecast.
  "observability": {
    "enabled": true
  }
}
